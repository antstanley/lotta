        "completion_tokens": 0,
        "total_tokens": 0
      }
    }
  },
  "observable": {
    "provider_calls_delta": 1,
    "created_delta": 1,
    "deleted_delta": 0,
    "forked_delta": 0,
    "conversations": [
      {
        "id": "<CONVERSATION_ID>",
        "agent_id": "agent-local-visible",
        "hidden": false,
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "<USER_TEXT_C>"
              }
            ],
            "otid": "<UUID>"
          }
        ]
      }
    ]
  }
