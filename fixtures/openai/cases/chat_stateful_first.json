{
  "schema_version": 1,
  "name": "chat_stateful_first",
  "route": "chat",
  "mode": "json",
  "dependencies": [],
  "request": {
    "method": "POST",
    "path": "/v1/chat/completions",
    "mode": "json",
    "headers": {
      "authorization": "<AUTHORIZATION>",
      "x-letta-chat-key": "<CHAT_KEY>"
    },
    "body": {
      "model": "fixture-visible",
      "messages": [
        {
          "role": "user",
          "content": "<USER_TEXT_C>"
        }
      ]
