{
  "method": "POST",
  "endpoint": "/v1/chat/completions",
  "headers": {
    "accept": "text/event-stream",
    "content-type": "application/json"
  },
  "presence_only_headers": [
    "content-length",
    "credential",
    "host"
  ],
  "body": {
    "model": "fixture-model",
    "messages": [
      {
        "role": "system",
        "content": "SANITIZED_FIXTURE_SYSTEM"
      },
      {
        "role": "user",
        "content": "SANITIZED_FIXTURE_USER"
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "max_tokens": 256,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "fixture_tool",
          "description": "SANITIZED_FIXTURE_TOOL",
          "parameters": {
            "type": "object",
            "properties": {
              "a": {
                "type": "integer"
              }
            },
            "required": [
              "a"
            ]
          }
        }
      }
    ],
    "tool_choice": "auto"
  }
}
